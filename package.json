{
  "name": "type-graphql-dataloader",
  "description": "A utility to use DataLoader with TypeGraphQL without fuss",
  "version": "0.6.0",
  "author": {
    "name": "Dillon Sadofsky",
    "url": "https://github.com/DillonSadofsky"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DillonSadofsky/type-graphql-dataloader.git"
  },
  "keywords": [
    "typescript",
    "graphql",
    "dataloader",
    "typeorm"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/DillonSadofsky/type-graphql-dataloader/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "./dist/**/*.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build watch": "tsc -w -p tsconfig.build.json",
    "prepack": "yarn install && tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "dev:typeorm": "ts-node-dev -r tsconfig-paths/register examples/typeorm/index.ts",
    "test": "jest",
    "prepublishOnly": "npm run-script clean && npm run-script build"
  },
  "dependencies": {
    "dataloader": "^2.2.3",
    "lodash-es": "^4.17.22",
    "reflect-metadata": "^0.1.14",
    "typedi": "^0.10.0"
  },
  "devDependencies": {
    "@apollo/server": "^5.2.0",
    "@as-integrations/express5": "^1.1.2",
    "@types/body-parser": "^1.19.6",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.21",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.0.3",
    "class-validator": "^0.14.3",
    "express": "^5.2.1",
    "graphql": "^16.6.0",
    "graphql-request": "^7.4.0",
    "graphql-scalars": "^1.25.0",
    "jest": "^30.2.0",
    "rimraf": "^6.1.2",
    "sqlite3": "^5.1.7",
    "ts-jest": "^29.4.6",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^3.15.0",
    "type-graphql": "^2.0.0-rc.2",
    "typescript": "^5.9.3",
    "uuid": "^11.1.0"
  },
  "peerDependencies": {
    "typeorm": ">=0.3.17"
  }
}
